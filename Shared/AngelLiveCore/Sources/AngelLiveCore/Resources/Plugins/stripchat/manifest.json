{
  "pluginId": "stripchat",
  "version": "1.0.2",
  "apiVersion": 1,
  "displayName": "Stripchat",
  "platformDescription": "Stripchat 直播（HLS 最高画质 + 声音）",
  "liveTypes": ["stripchat"],
  "entry": "stripchat.js",
  "auth": {
    "required": false,
    "credentialKinds": ["cookie"],
    "supportsStatusCheck": false,
    "supportsValidation": false
  },
  "loginFlow": {
    "kind": "webview",
    "loginURL": "https://zh.stripchat.com/login",
    "cookieDomains": [".stripchat.com", "stripchat.com"],
    "authSignalCookies": ["AMP_"],
    "uidCookieNames": null
  },
  "hostBehavior": {
    "favoriteIdentityKey": "userId",
    "externalRoomURLTemplate": "https://zh.stripchat.com/{userName}",
    "themeColor": "#FF3B6B"
  },
  "capabilities": {
    "categories": "available",
    "rooms": "available",
    "playback": "available",
    "search": "available",
    "roomDetail": "available",
    "liveState": "available",
    "homeFeed": "available"
  }
}
