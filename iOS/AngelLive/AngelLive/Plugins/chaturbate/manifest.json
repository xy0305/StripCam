{
  "pluginId": "chaturbate",
  "version": "1.0.0",
  "apiVersion": 1,
  "displayName": "Chaturbate",
  "platformDescription": "Chaturbate 成人直播（HLS 最高画质 + 声音）",
  "liveTypes": ["chaturbate"],
  "entry": "index.js",
  "auth": {
    "required": false,
    "credentialKinds": ["cookie"],
    "supportsStatusCheck": false,
    "supportsValidation": false
  },
  "loginFlow": {
    "kind": "webview",
    "loginURL": "https://chaturbate.com/accounts/login/",
    "cookieDomains": [".chaturbate.com", "chaturbate.com"],
    "authSignalCookies": ["csrftoken", "sessionid"],
    "uidCookieNames": null
  },
  "hostBehavior": {
    "favoriteIdentityKey": "userId",
    "externalRoomURLTemplate": "https://chaturbate.com/{userName}/",
    "themeColor": "#F26522"
  },
  "capabilities": {
    "categories": "available",
    "rooms": "available",
    "playback": "available",
    "search": "available",
    "roomDetail": "available",
    "liveState": "available",
    "homeFeed": "available"
  }
}
